# Copiar a application-local.yml (ese archivo está en .gitignore: NO se sube a Git)
# y reemplazar los valores. Se usa con:  mvn spring-boot:run -Dspring-boot.run.profiles=local
spring:
  datasource:
    url: jdbc:postgresql://TU-HOST-NEON/TU-BASE?sslmode=require
    username: TU-USUARIO-NEON
    password: TU-CLAVE-NEON
  rabbitmq:
    host: localhost                 # en EC2: la IP privada de la instancia de RabbitMQ
    port: 5672
    username: rutaexpress           # el RABBITMQ_DEFAULT_USER de docker/.env
    password: LA-CLAVE-DE-docker-.env   # el RABBITMQ_DEFAULT_PASS de docker/.env
